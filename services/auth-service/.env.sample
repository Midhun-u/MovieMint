# Nodemailer
NODEMAILER_GMAIL_APP_PASSWORD=<gmail_app_password>
NODEMAILER_GMAIL_USER_EMAIL=<gmail>

# Redis
REDIS_HOST=<redis_host>
REDIS_PORT=<redis_port>