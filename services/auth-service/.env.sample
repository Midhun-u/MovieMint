# Port
PORT=<port_number>

# Database
DB_DATABASE_NAME=<database_name>
DB_USERNAME=<database_user_name>
DB_HOST=<database_host>
DB_PORT=<database_port>
DB_PASSWORD=<database_password>

# Admin key
ADMIN_KEY=<admin_key>

# Client urls
APP_CLIENT_URL=<client_url>
ADMIN_DASHBOARD_URL=<admin_dashboard_url>
